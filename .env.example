# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Cloudflare Workers AI (required for SimulatorAgent and JudgeAgent)
# Account ID: Cloudflare dashboard → right sidebar
# API token:  Cloudflare dashboard → My Profile → API Tokens
#             Create a token with "Workers AI Run" permission
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# GPT-1900 server (required for ScientistAgent)
# Set this to the DigitalOcean droplet IP once the server is running
SCIENTIST_API_URL=http://your-droplet-ip:8000
