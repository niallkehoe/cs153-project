# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# OpenRouter (required for SimulatorAgent and JudgeAgent)
# Get your key at https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=sk-or-v1-...

# GPT-1900 server (required for ScientistAgent)
# Keep the SSH tunnel open: gcloud compute ssh gpu-l4-1 --zone=us-central1-c --project=cs229-497921 -- -NL 8000:localhost:8000
SCIENTIST_API_URL=http://localhost:8000

# Optional: override the OpenRouter models used for simulator and judge
# Default for both: anthropic/claude-3.5-haiku
# SIMULATOR_MODEL=anthropic/claude-3.5-haiku
# JUDGE_MODEL=anthropic/claude-3.5-haiku
